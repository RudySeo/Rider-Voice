{
  "description": "Enforce test-first edits and validate the project before Codex commits.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd); bash \"$ROOT/.codex/hooks/tdd-guard.sh\"",
            "timeout": 30,
            "statusMessage": "Checking TDD guard"
          }
        ]
      },
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd); python3 \"$ROOT/.codex/hooks/pre-commit-checks.py\"",
            "timeout": 600,
            "statusMessage": "Running lint, build, and test before commit"
          }
        ]
      }
    ]
  }
}
