# Local Docker runtime example. Copy to .env.docker.local and replace placeholders.
SPRING_PROFILES_ACTIVE=prod

DB_URL=jdbc:mysql://host.docker.internal:3306/rider?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
DB_USERNAME=replace-with-local-db-user
DB_PASSWORD=replace-with-local-db-password

KAKAO_CLIENT_ID=replace-with-kakao-rest-api-key
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8080/api/v1/auth/oauth2/callback/kakao
KAKAO_LOCAL_REST_API_KEY=replace-with-kakao-rest-api-key

FRONTEND_BASE_URL=http://localhost:5173
AUTH_COOKIE_SECURE=false
