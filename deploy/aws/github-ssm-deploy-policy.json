{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RunOnlyTheApprovedDocumentOnTheProductionInstance",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": [
        "arn:aws:ssm:ap-northeast-2::document/AWS-RunShellScript",
        "arn:aws:ec2:ap-northeast-2:__AWS_ACCOUNT_ID__:instance/__EC2_INSTANCE_ID__"
      ]
    },
    {
      "Sid": "ReadCommandResult",
      "Effect": "Allow",
      "Action": "ssm:GetCommandInvocation",
      "Resource": "*"
    }
  ]
}
