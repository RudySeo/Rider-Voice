# Required only for the aws profile. Use the HTTPS origin without /api/v1.
EXPO_PUBLIC_AWS_API_BASE_URL=https://api-dev.example.com

# Optional. Local physical devices normally derive the Mac IP from the Metro host.
# Set this when using an Expo tunnel or a non-standard local network.
# EXPO_PUBLIC_LOCAL_API_BASE_URL=http://192.168.0.10:8080
